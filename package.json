{
  "name": "divine_shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npx tailwindcss -i ./divine_shop/static/css/input.css -o ./divine_shop/static/css/output.css --minify",
    "watch": "npx tailwindcss -i ./divine_shop/static/css/input.css -o ./divine_shop/static/css/output.css --watch",
    "dev": "npm run watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0"
  }
}
